# 推荐通过 `secagentx onboard` 配置。容器/CI 可使用以下通用变量：
# SECAGENTX_ACTIVE_PROVIDER=openai_compatible
# SECAGENTX_LLM_API_BASE=https://your-provider.example/v1
# SECAGENTX_LLM_MODEL=your-model-id
# SECAGENTX_LLM_API_KEY=replace-with-provider-key
# SECAGENTX_LLM_ALLOW_NO_KEY=false
# 旧版 DEEPSEEK_API_KEY / QWEN_API_KEY 仍兼容，但不再是必选厂商。

# Threat Intelligence API Keys
# 至少配置一个即可正常使用威胁情报功能。
# 若全部未配置，系统只使用本地情报并明确报告外部覆盖不足，不会生成示例结果。
# OTX_API_KEY=replace-with-real-key
# VT_API_KEY=replace-with-real-key
# ABUSEIPDB_API_KEY=replace-with-real-key

# Server
SECAGENTX_HOST=127.0.0.1
SECAGENTX_PORT=8000
SECAGENTX_DEBUG=false
# 服务只监听本机回环地址，勿将其反向代理或暴露到公网。
# SECAGENTX_ALLOWED_HOSTS=secagentx.example.com
# SECAGENTX_FORCE_HSTS=true
# SECAGENTX_CORS_ORIGINS=https://secagentx.example.com

# Optional infrastructure credentials (required only when the service is enabled)
# OPENIM_SECRET=replace-with-openim-app-secret
# PG_PASSWORD=replace-with-postgres-password
# REDIS_PASSWORD=replace-with-redis-password
# Docker Compose 使用 POSTGRES_PASSWORD，且不提供默认密码：
# POSTGRES_PASSWORD=replace-with-a-strong-random-postgres-password

# 跨区域联邦 Token（每个对端区域一个，值随意但需两端一致）
# FED_TOKEN_BEIJING=your-federation-token-for-beijing
# FED_TOKEN_SHANGHAI=your-federation-token-for-shanghai
# FED_TOKEN_SHENZHEN=your-federation-token-for-shenzhen

# 旧版提供商选择（推荐改用 secagentx onboard）
# LLM_PROVIDER=mock

# ─── 防火墙后端 ───
# disabled : 不执行防火墙变更（默认）
# mock     : 本地 JSON 模拟（仅测试）
# iptables : 真实 iptables 封禁（生产 Linux）
# nftables : nftables 封禁（现代 Linux）
# aliyun   : 阿里云安全组 API
# tencent  : 腾讯云安全组 API
# aws      : AWS 安全组 / WAF IP Set
FIREWALL_BACKEND=disabled

# 阿里云防火墙（FIREWALL_BACKEND=aliyun 时必填）
# ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
# ALIYUN_SECURITY_GROUP_ID=sg-bp1xxxxxxxxxxxxx
# ALIYUN_REGION_ID=cn-beijing

# 腾讯云防火墙（FIREWALL_BACKEND=tencent 时必填）
# TENCENT_SECRET_ID=your-secret-id
# TENCENT_SECRET_KEY=your-secret-key
# TENCENT_SECURITY_GROUP_ID=sg-xxxxxxxx
# TENCENT_REGION_ID=ap-guangzhou
# TENCENT_VPC_ID=

# AWS 防火墙（FIREWALL_BACKEND=aws 时必填）
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxx
# AWS_REGION=us-east-1
# AWS_USE_WAF=false
