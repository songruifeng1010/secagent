# ============================================
# SecAgentX - .gitignore
# ============================================

# 环境变量（含 API Key，禁止提交）
.env
.env.local
.env.production

# Python
__pycache__/
.venv/
venv/
.secagent-git/
.credentials/
.playwright-browsers/
*.py[cod]
*.pyo
*.egg-info/
*.eggs/
dist/
# Git URL / pipx 安装需要已构建的默认 Web；根目录 dist 仍用于 Python 发行物。
!frontend/dist/
!frontend/dist/**
build/
build-final*/
dist-final*/
test-runtime*/
.pytest_cache/
.pytest-*/
.pytest-tmp/
.pytest-cache*/
.pytest-tmp*/
.runtime-tmp*/
.acceptance-secagentx/
.final-e2e-home/
.tmp-secagentx-home/
.coverage
.coverage.*
*.cover
htmlcov/
.mypy_cache/
.ruff_cache/

# 运行时数据
data/
exports/
reports/
*.db
*.sqlite3

# 日志（含轮转压缩文件）
logs/
*.log
*.log.*
*.gz

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 前端
frontend/node_modules/
# 发布 wheel 需要可复现的预构建 Web 资源；dist 由 CI 构建并纳入发布内容。
frontend/.vite/
frontend/.npm-cache*/
frontend/.node-tmp*/
frontend/playwright-report/
frontend/test-results/

# Docker
.docker/
docker-compose*.override.yml

# 系统
.DS_Store
Thumbs.db

# 备份文件
*.bak
*.bak*

# v2.7 加固：禁止提交任何 .env 备份（含敏感密钥）
.env.*
.env.bak
.env.bak*
# 只提交无密钥的配置模板；实际 .env 仍保持忽略。
!.env.example
!frontend/.env.example
*.env.bak

# 根目录 node_modules 缓存（非 frontend 依赖）
node_modules/
